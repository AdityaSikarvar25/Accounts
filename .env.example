# Paste your Supabase connection string below (the app converts it to use pg8000 automatically)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-your-password
# Optional: set to 'production' on Render to enable secure cookies
FLASK_ENV=development
# Optional: only needed for Netlify+Render split deployment
# ALLOWED_ORIGIN=https://your-app.netlify.app
